<?xml version="1.0" encoding="UTF-8"?>


<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">


<suite name="Automation Exercise Suite">


    <listeners>
       <listener class-name="com.automationExercise.listeners.ScreenshotListener"/>
    </listeners>


    <test name="Smoke Tests">

        <groups>
            <run>
                <include name="smoke"/>
            </run>
        </groups>

        <packages>
            <package name="com.automationExercise.test"/>
        </packages>

    </test>


</suite>
